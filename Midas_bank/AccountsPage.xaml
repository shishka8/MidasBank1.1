<UserControl x:Class="MidasBank.AccountsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Банковские счета" Foreground="{StaticResource GoldPrimary}" FontSize="28" Margin="0,0,0,20"/>
            <DataGrid x:Name="DgAccounts" AutoGenerateColumns="False" IsReadOnly="True" 
                      Background="{StaticResource MidasGray}" Foreground="White" BorderThickness="1" BorderBrush="{StaticResource GoldDark}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Номер счета" Binding="{Binding AccountNumber}" Width="*"/>
                    <DataGridTextColumn Header="Баланс" Binding="{Binding Balance, StringFormat={}{0:C}}" Width="150"/>
                    <DataGridTextColumn Header="Тип" Binding="{Binding AccountTypes.TypeName}" Width="150"/>
                    <DataGridTextColumn Header="Владелец" Binding="{Binding Clients.FullName}" Width="*"/>
                    <DataGridTextColumn Header="Счет" Binding="{Binding AccountNumber}" Width="150"/>
                    <DataGridTextColumn Header="Баланс" Binding="{Binding Balance, StringFormat={}{0:N2} Gold}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="{StaticResource GoldPrimary}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</UserControl>