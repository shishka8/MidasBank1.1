<Window x:Class="MidasBank.AppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Midas Bank — Панель управления" 
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen" 
        Background="{StaticResource MidasBlack}"
        Icon="bank_icon.ico">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource MidasGray}" BorderBrush="{StaticResource GoldDark}" BorderThickness="0,0,1,0">
            <Grid>
                <StackPanel Margin="10">
                    <TextBlock Text="MIDAS BANK" Foreground="{StaticResource GoldPrimary}" 
                               FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,20,0,40"/>

                    <Button Content="👥 Клиенты" Click="BtnClients_Click" Style="{StaticResource MidasButtonStyle}" Margin="0,5"/>
                    <Button Content="💰 Счета" Click="BtnAccounts_Click" Style="{StaticResource MidasButtonStyle}" Margin="0,5"/>
                    <Button Content="🔄 Переводы" Click="BtnTrans_Click" Style="{StaticResource MidasButtonStyle}" Margin="0,5"/>
                    <Button Content="🏠 Главная" Click="BtnDashboard_Click" Style="{StaticResource MidasButtonStyle}" Margin="0,5"/>
                    <Button Content="🧮 Кредитный Калькулятор" Click="BtnCalcMenu_Click" Style="{StaticResource MidasButtonStyle}" Margin="0,5"/>

                    <Separator Margin="0,20" Background="{StaticResource GoldDark}"/>
                    <Button x:Name="BtnReports" Content="📂 Отчеты" Style="{StaticResource MidasButtonStyle}" IsEnabled="True" Margin="0,20,0,0" Click="BtnReports_Click"/>
                </StackPanel>

                <Button Content="Выход" VerticalAlignment="Bottom" Margin="10" Click="BtnExit_Click" Background="Transparent" Foreground="Gray" BorderThickness="0"/>
            </Grid>
        </Border>

        <ContentControl x:Name="MainContainer" Grid.Column="1" Margin="20"/>
    </Grid>
</Window>