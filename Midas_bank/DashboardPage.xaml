<UserControl x:Class="MidasBank.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="30">
        <StackPanel>
            <TextBlock Text="АНАЛИТИКА MIDAS BANK" Foreground="{StaticResource GoldPrimary}" 
                       FontSize="28" FontWeight="Bold" Margin="0,0,0,30"/>

            <UniformGrid Columns="3" Height="150">
                <Border Background="#1E1E1E" CornerRadius="15" Margin="10" BorderBrush="{StaticResource GoldDark}" BorderThickness="1">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="КАПИТАЛ БАНКА" Foreground="Gray" HorizontalAlignment="Center" FontSize="12"/>
                        <TextBlock x:Name="txtTotalBalance" Text="0.00" Foreground="{StaticResource GoldPrimary}" 
                                   FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10"/>
                        <TextBlock Text="золотых слитков" Foreground="#444" HorizontalAlignment="Center" FontSize="10"/>
                    </StackPanel>
                </Border>

                <Border Background="#1E1E1E" CornerRadius="15" Margin="10" BorderBrush="{StaticResource GoldDark}" BorderThickness="1">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="АКТИВНЫЕ КЛИЕНТЫ" Foreground="Gray" HorizontalAlignment="Center" FontSize="12"/>
                        <TextBlock x:Name="txtTotalClients" Text="0" Foreground="White" 
                                   FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5"/>
                        <TextBlock Text="человек" Foreground="#444" HorizontalAlignment="Center" FontSize="10"/>
                    </StackPanel>
                </Border>

                <Border Background="#1E1E1E" CornerRadius="15" Margin="10" BorderBrush="{StaticResource GoldDark}" BorderThickness="1">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ВСЕГО ТРАНЗАКЦИЙ" Foreground="Gray" HorizontalAlignment="Center" FontSize="12"/>
                        <TextBlock x:Name="txtTotalTrans" Text="0" Foreground="White" 
                                   FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5"/>
                        <TextBlock Text="операций проведено" Foreground="#444" HorizontalAlignment="Center" FontSize="10"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="Текущий статус системы: Работает штатно (Digital Core v1.0)" 
                       Foreground="#333" Margin="10,20,0,0" FontSize="10" HorizontalAlignment="Left"/>
        </StackPanel>
    </Grid>
</UserControl>
