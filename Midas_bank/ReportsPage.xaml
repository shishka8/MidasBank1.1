<UserControl x:Class="MidasBank.ReportsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="30">
        <StackPanel>
            <TextBlock Text="ЦЕНТР ГЕНЕРАЦИИ ОТЧЕТОВ" Foreground="{StaticResource GoldPrimary}" 
                       FontSize="26" FontWeight="Bold" Margin="0,0,0,30"/>

            <WrapPanel>
                <Border Background="#1E1E1E" Width="250" Height="200" CornerRadius="15" Margin="10" BorderBrush="#333" BorderThickness="1">
                    <StackPanel Margin="20">
                        <TextBlock Text="👤" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="СПИСОК КЛИЕНТОВ" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Выгрузка всей базы клиентов в формате Excel" Foreground="Gray" FontSize="10" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10"/>
                        <Button Content="СКАЧАТЬ" Style="{StaticResource MidasButtonStyle}" Click="BtnClientsReport_Click"/>
                    </StackPanel>
                </Border>

                <Border Background="#1E1E1E" Width="250" Height="200" CornerRadius="15" Margin="10" BorderBrush="#333" BorderThickness="1">
                    <StackPanel Margin="20">
                        <TextBlock Text="💰" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="ИСТОРИЯ ОПЕРАЦИЙ" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Все денежные переводы за все время" Foreground="Gray" FontSize="10" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10"/>
                        <Button Content="СКАЧАТЬ" Style="{StaticResource MidasButtonStyle}" Click="BtnTransReport_Click"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </StackPanel>
    </Grid>
</UserControl>