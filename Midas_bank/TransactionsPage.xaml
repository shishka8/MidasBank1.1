<UserControl x:Class="MidasBank.TransactionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="800">
    <Grid Margin="30">
        <StackPanel>
            <TextBlock Text="МЕЖБАНКОВСКИЙ ПЕРЕВОД" Foreground="{StaticResource GoldPrimary}" 
                       FontSize="26" FontWeight="Bold" Margin="0,0,0,30"/>

            <Border Background="{StaticResource MidasGray}" CornerRadius="15" Padding="25" BorderBrush="{StaticResource GoldDark}" BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="СЧЕТ СПИСАНИЯ" Foreground="Gray" FontSize="11" Margin="0,0,0,8"/>
                            <ComboBox x:Name="cbSourceAccount" Height="40"
          Style="{StaticResource MidasInputStyle}"
          DisplayMemberPath="AccountNumber">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Background" Value="#1A1A1A"/>
                                        <Setter Property="Foreground" Value="{StaticResource GoldPrimary}"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#333"/>
                                        <Setter Property="Padding" Value="5"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>

                            </ComboBox>

                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="➔" Foreground="{StaticResource GoldPrimary}" 
                                   FontSize="30" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,15,0,0"/>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="СЧЕТ ЗАЧИСЛЕНИЯ" Foreground="Gray" FontSize="11" Margin="0,0,0,8"/>
                            <ComboBox x:Name="cbTargetAccount" Height="40"
          Style="{StaticResource MidasInputStyle}"
          DisplayMemberPath="AccountNumber">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Background" Value="#1A1A1A"/>
                                        <Setter Property="Foreground" Value="{StaticResource GoldPrimary}"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#333"/>
                                        <Setter Property="Padding" Value="5"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>

                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,40" Background="#333" Height="1"/>

                    <StackPanel HorizontalAlignment="Center" Width="250">
                        <TextBlock Text="СУММА" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBox x:Name="txtAmount" Style="{StaticResource MidasInputStyle}" 
                                 FontSize="22" TextAlignment="Center" FontWeight="Bold" Height="50" VerticalContentAlignment="Center"/>

                        <Button Content="ПЕРЕВЕСТИ" Style="{StaticResource MidasButtonStyle}" 
                                Height="50" Margin="0,30,0,0" Click="BtnTransfer_Click">
                            <Button.Effect>
                                <DropShadowEffect BlurRadius="10" Color="Gold" Opacity="0.3"/>
                            </Button.Effect>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>