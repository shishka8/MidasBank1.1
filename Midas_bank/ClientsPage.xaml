<UserControl x:Class="MidasBank.ClientsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <StackPanel>
            <TextBlock Text="Управление клиентами" Foreground="{StaticResource GoldPrimary}" FontSize="28" Margin="0,0,0,20"/>

            <Border Background="{StaticResource MidasGray}" CornerRadius="10" Padding="15">
                <StackPanel>
                    <DockPanel LastChildFill="True" Margin="0,0,0,15">
                        <Button Content="+ Новый клиент" 
                                Style="{StaticResource MidasButtonStyle}" 
                                Width="150" 
                                DockPanel.Dock="Right"
                                Click="BtnAdd_Click"/>
                        <TextBox x:Name="SearchBox" 
                                 Style="{StaticResource MidasInputStyle}" 
                                 Width="300" HorizontalAlignment="Left" 
                                 Tag="Поиск по ФИО..."
                                 TextChanged="SearchBox_TextChanged"/>
                    </DockPanel>

                    <DataGrid x:Name="DgClients" AutoGenerateColumns="False" IsReadOnly="True" 
                              Background="Transparent" Foreground="White" BorderThickness="0"
                              RowBackground="#252525" AlternatingRowBackground="#1E1E1E" ColumnHeaderHeight="40">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ClientID}" Width="50"/>
                            <DataGridTextColumn Header="ФИО Клиента" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="Паспорт" Binding="{Binding PassportData}" Width="150"/>
                            <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
    
</UserControl>